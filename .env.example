# ==============================================================================
# ReLoop Environment Configuration (.env.example)
# Copy this file to .env before starting services
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=8080

# PostgreSQL Configuration (Docker Compose Maps to 5433:5432)
POSTGRES_DB=reloop_db
POSTGRES_USER=reloop_app
POSTGRES_PASSWORD=reloop_secret_password
DB_HOST=localhost
DB_PORT=5433
DB_USER=reloop_app
DB_PASSWORD=reloop_secret_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Mailpit (Local SMTP Mock)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
PORT=3000
